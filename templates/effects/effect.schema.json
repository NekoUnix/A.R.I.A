{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARIA effect design version 1",
  "type": "object",
  "required": [
    "aria_effect",
    "design"
  ],
  "properties": {
    "aria_effect": {
      "const": 1
    },
    "design": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "enum": [
            "Throw",
            "Spray"
          ]
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "selection": {
          "enum": [
            "Random",
            "Cycle",
            "All"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "hotkey": {
          "type": [
            "object",
            "null"
          ],
          "description": "Assigned in ARIA; cleared when importing"
        },
        "interval": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "flight": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        },
        "size": {
          "type": "number",
          "minimum": 0.005,
          "maximum": 1.5
        },
        "size_variance": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "arc": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "spin": {
          "type": "number",
          "minimum": -1440,
          "maximum": 1440
        },
        "bounce": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "lifetime": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 15
        },
        "impact": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "splash": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cooldown": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "origin": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -2,
            "maximum": 2
          }
        },
        "target": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -2,
            "maximum": 2
          }
        },
        "tint": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "launch_sound": {
          "type": "string",
          "maxLength": 4096
        },
        "impact_sound": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
