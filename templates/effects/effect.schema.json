{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARIA effect design version 1",
  "type": "object",
  "required": [
    "aria_effect",
    "design"
  ],
  "properties": {
    "aria_effect": {
      "const": 1
    },
    "design": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "enum": [
            "Throw",
            "Spray"
          ]
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "selection": {
          "enum": [
            "Random",
            "Cycle",
            "All"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "hotkey": {
          "type": [
            "object",
            "null"
          ],
          "description": "Assigned in ARIA; cleared when importing"
        },
        "interval": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "flight": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        },
        "size": {
          "type": "number",
          "minimum": 0.005,
          "maximum": 1.5
        },
        "size_variance": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "arc": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "spin": {
          "type": "number",
          "minimum": -1440,
          "maximum": 1440
        },
        "bounce": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "lifetime": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 120
        },
        "impact": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "splash": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cooldown": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "origin": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -2,
            "maximum": 2
          }
        },
        "target": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -2,
            "maximum": 2
          }
        },
        "tint": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "launch_sound": {
          "type": "string",
          "maxLength": 4096
        },
        "impact_sound": {
          "type": "string",
          "maxLength": 4096
        },
        "routes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "origin",
              "target"
            ],
            "properties": {
              "origin": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": -2,
                  "maximum": 2
                }
              },
              "target": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": -2,
                  "maximum": 2
                }
              }
            }
          }
        },
        "asset_counts": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "description": "Must match assets length unless empty. Total including All routes is 1-1000."
        },
        "route_selection": {
          "enum": [
            "Random",
            "Cycle",
            "All"
          ]
        },
        "speed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        },
        "gravity": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "drag": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "stickiness": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "fade_out": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 30
        },
        "liquid": {
          "type": "object",
          "properties": {
            "gloss": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "clarity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "viscosity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "drip": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.2
            },
            "foam": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "trail": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
