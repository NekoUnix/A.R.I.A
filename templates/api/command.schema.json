{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "set_parameters"
            },
            "values": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 64,
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "required": [
            "type",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "release_parameters"
            },
            "ids": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "pose"
            },
            "frozen": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "frozen"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "preset"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "index"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "expression"
            },
            "id": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "id",
            "enabled"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "output"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "open": {
              "type": "boolean"
            },
            "zoom": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 3
            },
            "position": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            }
          },
          "required": [
            "type",
            "index",
            "open"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "theme"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "save_profile"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "imported_action"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "version",
    "generation",
    "action"
  ],
  "additionalProperties": false
}
